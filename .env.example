# Azure Service Fabric Managed Clusters MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Azure subscription ID
AZURE_SUBSCRIPTION_ID=

# Optional: Service Principal Authentication
# If not provided, will use DefaultAzureCredential (Azure CLI, Managed Identity, etc.)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: Domains to enable (default: sfmc)
# Options: all, core, sfmc
DOMAINS=sfmc
